# Azure AI Foundry (AI Services) -- used ONLY for the photo pass.
# The system runs fully without these; photo-triggered questions are simply
# not offered and the observation still goes to human review (AUDIT.md A4).
AZURE_AI_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com/
AZURE_AI_DEPLOYMENT=<your-deployment-name>
AZURE_AI_API_VERSION=2024-10-21
AZURE_AI_KEY=<your-key>
